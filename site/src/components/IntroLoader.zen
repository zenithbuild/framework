<script setup="ts">
import { gsap } from "gsap";
import { SplitText } from "gsap/SplitText";
import ZenithNavigationMark from "@/components/ZenithNavigationMark.zen";
import TransitionIdentity from "@/components/transition/TransitionIdentity.zen";
import { transitionTiming } from "./transition/transitionTiming";
import { getTransitionIdentity, enterArtwork, exitArtwork, revealThroughOverlay } from "./transition/transitionArtwork";

type IntroPhase = "pending" | "loading" | "revealingMark" | "markRevealed" | "artworkExit" | "revealingContent" | "complete";
interface ElementRef<T> { current?: T | null; }
interface Props {
  enabled?: boolean;
  navigationShellRef: ElementRef<HTMLElement>;
  pageShellRef: ElementRef<HTMLElement>;
  footerShellRef: ElementRef<HTMLElement>;
  heroEyebrowRef?: ElementRef<HTMLElement>;
  heroTitleRef?: ElementRef<HTMLElement>;
  heroDescriptionRef?: ElementRef<HTMLElement>;
  heroActionsRef?: ElementRef<HTMLElement>;
  heroSupportRef?: ElementRef<HTMLElement>;
}
interface IntroWindow extends Window {
  __zenithIntroCommitted?: boolean;
  __zenithIntroComplete?: boolean;
  __zenithIntroStarted?: boolean;
  __zenithIntroPlayed?: boolean;
  __zenithIntroTimelineActive?: boolean;
}

const introProps = props as Props;
const introEnabled = introProps.enabled === true;
const introStorageKey = "zenith.intro.seen";
const phrases = ["Prime trusted runtime", "Compile route graph"];
const heroEyebrowRef = introProps.heroEyebrowRef || ref<HTMLElement>();
const heroTitleRef = introProps.heroTitleRef || ref<HTMLElement>();
const heroDescriptionRef = introProps.heroDescriptionRef || ref<HTMLElement>();
const heroActionsRef = introProps.heroActionsRef || ref<HTMLElement>();
const heroSupportRef = introProps.heroSupportRef || ref<HTMLElement>();
const loaderRef = ref<HTMLElement>();
const backdropRef = ref<HTMLElement>();
const compositionRef = ref<HTMLElement>();
const markRef = ref<HTMLElement>();
state introPhase = "pending";
let skipActiveIntro = () => {};
function skipIntro() { skipActiveIntro(); }

function setDocumentState(phase: IntroPhase) {
  introPhase = phase;
  zenDocument()?.documentElement.setAttribute("data-zenith-intro-state", phase);
}

function setGateAccess(gates: HTMLElement[], hidden: boolean) {
  for (const gate of gates) {
    if (hidden) {
      gate.setAttribute("inert", "");
      gate.setAttribute("aria-hidden", "true");
    } else {
      gate.removeAttribute("inert");
      gate.removeAttribute("aria-hidden");
    }
  }
}

zenMount((ctx) => {
  const win = zenWindow() as IntroWindow | null;
  const doc = zenDocument();
  if (!win || !doc) return;
  const loader = loaderRef.current;
  const backdrop = backdropRef.current;
  const composition = compositionRef.current;
  const mark = markRef.current;
  if (win.__zenithIntroTimelineActive) return;
  let seen = false;
  try { seen = win.sessionStorage.getItem(introStorageKey) === "1"; } catch {}
  const motionPreference = win.matchMedia("(prefers-reduced-motion: reduce)");
  if (!introEnabled || win.location.pathname.replace(/\/+$/, "") || win.location.hash || seen ||
      win.__zenithIntroCommitted || motionPreference.matches || !loader || !backdrop || !composition || !mark) {
    setDocumentState("complete");
    return;
  }
  const art = getTransitionIdentity(composition, mark);
  if (!art) { setDocumentState("complete"); return; }
  const { glow, rings, markRing, markCore, labelFrame, label } = art;
  const gates = collectRefs(introProps.navigationShellRef, introProps.pageShellRef, introProps.footerShellRef) as HTMLElement[];
  const heroElements = collectRefs(heroEyebrowRef, heroDescriptionRef, heroActionsRef, heroSupportRef) as HTMLElement[];
  const heroTitle = heroTitleRef.current;
  const scrollbarWidth = Math.max(0, win.innerWidth - doc.documentElement.clientWidth);
  doc.documentElement.style.setProperty("--zenith-scrollbar-width", `${scrollbarWidth}px`);

  gsap.registerPlugin(SplitText);
  let timeline: gsap.core.Timeline | null = null;
  let heroSplit: SplitText | null = null;
  let heroLineTween: gsap.core.Tween | null = null;
  let phraseSplit: SplitText | null = null;
  let finished = false;
  let releaseListeners = () => {};

  function disposePhraseSplit() {
    gsap.set(label, { autoAlpha: 0 });
    phraseSplit?.revert();
    phraseSplit = null;
    label.textContent = "";
  }

  function finishIntro() {
    if (finished) return;
    finished = true;
    releaseListeners();
    const restoreFocus = loader.contains(doc.activeElement);
    timeline?.kill();
    heroLineTween?.kill();
    heroSplit?.revert();
    disposePhraseSplit();
    gsap.set([...gates, ...heroElements], { clearProps: "opacity,visibility,transform,pointerEvents,willChange" });
    setGateAccess(gates, false);
    setDocumentState("complete");
    if (restoreFocus) introProps.pageShellRef.current?.focus({ preventScroll: true });
    gsap.set(loader, { autoAlpha: 0, pointerEvents: "none", clearProps: "clipPath,willChange" });
    win.__zenithIntroTimelineActive = false;
    win.__zenithIntroComplete = true;
    win.__zenithIntroPlayed = true;
  }

  function revealContent() {
    setDocumentState("revealingContent");
    gsap.set(gates, { autoAlpha: 1 });
    if (heroElements.length) gsap.set(heroElements, { autoAlpha: 0, y: 18 });
    timeline = gsap.timeline({ paused: true, defaults: { ease: "power3.out" }, onComplete: finishIntro });
    revealThroughOverlay(timeline, loader, backdrop);
    if (heroElements.length) timeline.to(heroElements, { autoAlpha: 1, y: 0, duration: transitionTiming.destinationEntrance, stagger: transitionTiming.introHeroStagger }, 0.12);
    if (heroLineTween) {
      timeline.add(heroLineTween, 0.1);
      heroLineTween.paused(false);
    }
    timeline.play(0);
  }

  function playArtworkExit() {
    setDocumentState("artworkExit");
    timeline = gsap.timeline({ paused: true, defaults: { ease: "power3.out" }, onComplete: revealContent });
    exitArtwork(timeline, art);
    timeline.play(0);
  }

  function playPhrase(index: number) {
    label.textContent = phrases[index];
    let words: Element[];
    try {
      phraseSplit = SplitText.create(label, { type: "words", mask: "words", aria: "auto", wordsClass: "zenith-intro-word" });
      words = phraseSplit.words;
    } catch {
      words = [label];
    }
    gsap.set(labelFrame, { transformPerspective: 560 });
    gsap.set(words, { autoAlpha: 0, yPercent: 110, rotationX: -48, transformOrigin: "50% 100%" });
    gsap.set(label, { autoAlpha: 1 });
    timeline = gsap.timeline({ onComplete: () => {
      disposePhraseSplit();
      if (index + 1 < phrases.length) playPhrase(index + 1);
      else playArtworkExit();
    } });
    timeline
      .to(words, { autoAlpha: 1, yPercent: 0, rotationX: 0, duration: transitionTiming.introWordIn, stagger: transitionTiming.introWordStagger, ease: "power3.out" })
      .to({}, { duration: transitionTiming.introPhraseHold })
      .to(words, { autoAlpha: 0, yPercent: -105, rotationX: 42, duration: transitionTiming.introWordOut, stagger: transitionTiming.introWordStagger, ease: "power3.in" });
  }

  win.__zenithIntroCommitted = true;
  win.__zenithIntroStarted = true;
  win.__zenithIntroTimelineActive = true;
  try { win.sessionStorage.setItem(introStorageKey, "1"); } catch {}
  skipActiveIntro = finishIntro;
  const release = gsap.delayedCall(5.5, finishIntro);
  const removeHidden = zenOn(doc, "visibilitychange", () => { if (doc.hidden) finishIntro(); });
  const removeOrientation = zenOn(win, "orientationchange", finishIntro);
  const removePreference = zenOn(motionPreference, "change", () => { if (motionPreference.matches) finishIntro(); });
  releaseListeners = () => {
    release.kill();
    removeHidden();
    removeOrientation();
    removePreference();
    skipActiveIntro = () => {};
  };
  ctx.cleanup(finishIntro);

  setDocumentState("loading");
  setGateAccess(gates, true);
  gsap.set(gates, { autoAlpha: 0 });
  gsap.set(loader, { autoAlpha: 1, pointerEvents: "auto", clipPath: "inset(0% 0% 0% 0%)" });
  gsap.set(backdrop, { autoAlpha: 1 });
  gsap.set(glow, { autoAlpha: 0, scale: 0.68 });
  gsap.set(rings, { autoAlpha: 0, scale: 0.58 });
  gsap.set([markRing, markCore], { autoAlpha: 0, scale: 0.94 });
  gsap.set(mark, { autoAlpha: 0, scale: 0.7 });
  gsap.set(label, { autoAlpha: 0 });
  if (heroTitle) {
    heroSplit = SplitText.create(heroTitle, {
      type: "lines", mask: "lines", autoSplit: true, aria: "auto", linesClass: "zenith-hero-line",
      onSplit(split) {
        if (finished) return;
        heroLineTween = gsap.fromTo(split.lines, { yPercent: 112 }, { yPercent: 0, duration: 0.64, stagger: transitionTiming.introHeroStagger, ease: "power3.out", paused: true });
        return heroLineTween;
      },
    });
  }
  setDocumentState("revealingMark");
  timeline = gsap.timeline({ paused: true, defaults: { ease: "power3.out" }, onComplete: () => {
    setDocumentState("markRevealed");
    playPhrase(0);
  } });
  enterArtwork(timeline, art, 0);
  timeline.play(0);
});
</script>

<div
  ref={loaderRef}
  data-home-intro-root={introEnabled ? "true" : undefined}
  data-intro-loader="true"
  data-intro-phase={introPhase}
  aria-hidden={introPhase === "complete" || introPhase === "pending" ? "true" : "false"}
  on:esc={skipIntro}
  style={introEnabled ? undefined : "display: none;"}
  class="fixed inset-0 z-[80] grid place-items-center overflow-hidden text-foreground"
>
  <div ref={backdropRef} class="absolute inset-0 bg-background"></div>
  <button type="button" on:click={skipIntro} class="absolute right-4 top-4 z-30 inline-flex min-h-11 items-center rounded-full border border-border bg-background px-4 text-sm text-foreground v1-focus">Skip intro</button>
  <div ref={compositionRef} role="status" aria-live="polite" data-intro-composition="true">
    <TransitionIdentity>
      <div ref={markRef} data-intro-mark="true" class="relative h-20 w-20">
        <ZenithNavigationMark />
      </div>
    </TransitionIdentity>
  </div>
</div>
