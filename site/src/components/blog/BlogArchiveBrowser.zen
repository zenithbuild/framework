<script lang="ts">
import { archiveCategories, archiveRows, matchingPosts } from "./blogArchiveMarkup";
import type { BlogPost } from "@/server/postSource";

interface Props {
  posts: BlogPost[];
  categories: string[];
  tags: string[];
}

const archive = props as Props;
const posts = archive.posts || [];
const categories = ["All", ...(archive.categories || []).filter((category) => category !== "All")];
const tags = archive.tags || [];
state category = "All";
state tag = "All";

function renderCategoryPills(current: string) { return archiveCategories(categories, current); }
function renderArchiveRows(current: string, activeTag: string) { return archiveRows(posts, current, activeTag); }
function articleCount(current: string, activeTag: string) { return matchingPosts(posts, current, activeTag).length; }

function readFilters() {
  const win = zenWindow();
  if (!win) return;
  const params = new URL(win.location.href).searchParams;
  category = categories.find((value) => value.toLowerCase() === (params.get("category") || "").toLowerCase()) || "All";
  tag = tags.find((value) => value.toLowerCase() === (params.get("tag") || "").toLowerCase()) || "All";
}

function chooseCategory(event: MouseEvent) {
  if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
  const link = (event.target as Element | null)?.closest("a[data-category]");
  const win = zenWindow();
  if (!link || !win) return;
  event.preventDefault();
  const url = new URL(link.getAttribute("href") || "/blog", win.location.href);
  if (url.href !== win.location.href) win.history.pushState(win.history.state, "", url);
  readFilters();
}

zenMount((ctx) => {
  const win = zenWindow();
  if (!win) return;
  readFilters();
  ctx.cleanup(zenOn(win, "popstate", readFilters));
});
</script>

<section data-blog-archive="true" aria-labelledby="all-articles" class="mx-auto w-full max-w-[1440px] px-4 pb-16 pt-12 md:px-10 md:pb-24 md:pt-[72px] lg:px-20">
  <h2 id="all-articles" class="font-heading text-[32px] font-semibold leading-10 tracking-tight">All articles</h2>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-b border-border pb-5">
    <nav aria-label="Filter by category" class="flex flex-wrap gap-2" on:click={chooseCategory} unsafeHTML={renderCategoryPills(category)}></nav>
    <p data-blog-result-count="true" aria-live="polite" class="font-mono text-xs text-muted-foreground">{articleCount(category, tag)} {articleCount(category, tag) === 1 ? "article" : "articles"}</p>
  </div>
  <div data-blog-results="true" unsafeHTML={renderArchiveRows(category, tag)}></div>
  <p data-blog-empty-state="true" class="py-8 text-muted-foreground" style={articleCount(category, tag) ? "display:none" : undefined}>No published articles match these filters. <a class="v1-link" href="/blog">Show all articles</a></p>
  <a href="https://github.com/zenithbuild/framework/blob/integration/v1/CHANGELOG.md" class="v1-link mt-10 inline-flex min-h-11 items-center">Open changelog →</a>
</section>
