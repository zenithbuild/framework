<script lang="ts">
import { featuredTags } from "./blogArchiveMarkup";
import type { BlogPost } from "@/server/postSource";

export interface Props {
  post: BlogPost | null;
  label: string;
  actionLabel: string;
}

const incoming = props as Props;
const post = incoming.post || null;
const image = post ? post.cover?.image || null : null;
const imageSrc = image?.url || "";
const imageAlt = image?.alt || (post ? post.title : "");
const category = post?.category?.title || "";
const date = post?.displayPublishedAt || "";
const readingTime = post?.readingTime || "";
const author = post?.author?.name || "";
const tagList = featuredTags(post?.tags || []);
const updated = post?.displayUpdatedAt || "";
const postTitle = post?.title || "";
const postExcerpt = post?.excerpt || "";
const postPath = post?.path || "/blog";
</script>

<section data-blog-featured="true" aria-labelledby="featured-article-title" class="mx-auto w-full max-w-[1440px] px-4 md:px-10 lg:px-20" style={post ? undefined : "display: none;"}>
  <article class="grid gap-6 rounded-2xl border border-border bg-card p-6 md:grid-cols-[minmax(0,1fr)_minmax(180px,0.34fr)] md:gap-16 md:p-12">
    <div class="flex min-w-0 flex-col items-start gap-5">
      <p class="flex flex-wrap items-center gap-2"><span class="v1-eyebrow">Featured</span><span class="rounded-full bg-brand-blue-soft px-3 py-1 text-xs text-foreground">{category}</span></p>
      <h2 id="featured-article-title" class="max-w-[24ch] text-balance font-heading text-[32px] font-semibold leading-[1.08] tracking-tight md:text-[48px]">{postTitle}</h2>
      <p class="max-w-[64ch] text-base leading-7 text-muted-foreground md:text-lg">{postExcerpt}</p>
      <p class="flex flex-wrap gap-x-3 font-mono text-xs leading-5 text-muted-foreground"><span>{date}</span><span>{readingTime}</span><span>{author}</span></p>
      <a href={postPath} data-zen-link="true" class="v1-button v1-button-primary">Read post <span aria-hidden="true">→</span></a>
    </div>
    <aside class="flex min-w-0 flex-col items-start gap-3">
      <p class="v1-eyebrow">Tagged</p>
      <ul class="flex flex-wrap gap-2" unsafeHTML={tagList}></ul>
      <p class="text-sm text-muted-foreground" style={updated ? undefined : "display:none"}>Updated {updated}</p>
      <img src={imageSrc || undefined} alt={imageAlt} width={image?.width} height={image?.height} class="w-full rounded-lg object-contain" style={imageSrc ? undefined : "display: none;"} />
    </aside>
  </article>
</section>
