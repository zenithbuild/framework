    <div data-hero-out="expr" class="flex flex-col gap-[2px]">
      <p ref={headExprRef} class="flex items-center gap-2"><span aria-hidden="true" class="h-[6px] w-[6px] rounded-full bg-code-gold"></span><span class="text-code-gold">expression_bindings</span><span data-hero-out-pin="3" aria-hidden="true" class="grid h-[18px] w-[18px] shrink-0 place-items-center rounded-full border-[1.5px] font-mono text-[12px] leading-3 border-code-gold text-code-gold">3</span></p>
      <p class="whitespace-nowrap">&#123; marker_index, signal_index, … &#125;</p>
      <p class="font-sans text-[13px] leading-[18px] text-code-muted">Explicit expression table consumed by runtime without identifier lookup.</p>
