<script lang="ts">
// Hero output column: one clipped grid cell that stacks the compiled output and the failing build
// (Round 4 in-panel swap). Both states are in the DOM from first paint, so the cell height never changes.
// Fields and doc comments: compiler_types.rs:200-241; diagnostic: compiler_diagnostics.rs:232-235,
// parser_elements.rs:138-147 (integration/v1 @ dea39f22).
interface Props { headSignalRef?: any; headEventRef?: any; headExprRef?: any; }
const wellProps = props as Props;
const localHeadSignalRef = ref<HTMLElement>();
const localHeadEventRef = ref<HTMLElement>();
const localHeadExprRef = ref<HTMLElement>();
const headSignalRef = wellProps.headSignalRef || localHeadSignalRef;
const headEventRef = wellProps.headEventRef || localHeadEventRef;
const headExprRef = wellProps.headExprRef || localHeadExprRef;
</script>

<div class="hero-well-cell h-full font-mono text-[14px] leading-6 text-code-fg">
  <div data-hero-out-state="compiled" class="flex flex-col gap-[14px] px-5 py-[18px] max-md:px-[14px] max-md:py-4">
