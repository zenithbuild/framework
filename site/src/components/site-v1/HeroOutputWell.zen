      <p class="whitespace-nowrap">&#123; id, kind, state_index &#125;</p>
      <p class="font-sans text-[13px] leading-[18px] text-code-muted">Explicit signal table consumed by runtime without name lookup.</p>
    </div>
    <div data-hero-out="event" class="flex flex-col gap-[2px]">
      <p ref={headEventRef} class="flex items-center gap-2"><span aria-hidden="true" class="h-[6px] w-[6px] rounded-full bg-code-gold"></span><span class="text-code-gold">event_bindings</span><span data-hero-out-pin="2" aria-hidden="true" class="grid h-[18px] w-[18px] shrink-0 place-items-center rounded-full border-[1.5px] font-mono text-[12px] leading-3 border-code-gold text-code-gold">2</span></p>
      <p class="whitespace-nowrap">&#123; index, event, selector &#125;</p>
