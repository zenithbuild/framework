<script lang="ts">
import type { DocumentationViewModel } from "@/server/documentationViewModel";
import ReaderToc from "@/components/reader/ReaderToc.zen";
import DocumentationSidebarEntries from "@/components/docs/DocumentationSidebarEntries.zen";
import DocsArticleTransition from "@/components/reader/DocsArticleTransition.zen";

interface Props {
  view: DocumentationViewModel;
}

const documentationProps = props as Props;
const documentationView = documentationProps.view;
const documentationPrevious = documentationView.previous;
const documentationNext = documentationView.next;
const documentationArticleRef = ref<HTMLElement>();
const documentationArticleEndRef = ref<HTMLElement>();
const documentationArticleRegionRef = ref<HTMLElement>();
const docsCopyLiveRef = ref<HTMLElement>();
const docsEditUrl = documentationView.editUrl || "";
// v1 mobile chrome (handoff "Docs article" 155:11374): a "Section › Sections" bar opens the sidebar
// below 1024, and "On this page" is a disclosure below 1280. Both are plain disclosures (aria-expanded).
state docsSectionsOpen = false;
state docsTocOpen = false;

function docsToggleSections() {
  docsSectionsOpen = !docsSectionsOpen;
}

function docsToggleToc() {
  docsTocOpen = !docsTocOpen;
}

function docsAnnounce(message: string) {
  const region = docsCopyLiveRef.current;
  if (!region) return;
  region.textContent = "";
  const win = zenWindow();
  if (win) win.requestAnimationFrame(() => { region.textContent = message; });
}

// Code-panel Copy (delegated from the article). "Copied" resets on a 2s CSS clock (animationend),
// because component scripts may not schedule timers.
function docsArticleClick(event: MouseEvent) {
  const target = event.target as HTMLElement | null;
  const button = target?.closest ? (target.closest("[data-docs-copy]") as HTMLElement | null) : null;
  if (!button) return;
  const code = button.closest("[data-docs-code]")?.querySelector("pre")?.textContent || "";
  const clipboard = zenWindow()?.navigator?.clipboard;
  const done = (ok: boolean) => {
    button.setAttribute("data-copy-state", ok ? "copied" : "failed");
    button.textContent = ok ? "Copied" : "Copy";
    docsAnnounce(ok ? "Copied" : "Couldn't copy. Select the code and copy it yourself.");
  };
  if (!clipboard || typeof clipboard.writeText !== "function") { done(false); return; }
  clipboard.writeText(code).then(() => done(true), () => done(false));
}

function docsArticleAnimationEnd(event: AnimationEvent) {
  const target = event.target as HTMLElement | null;
  if (!target || target.getAttribute("data-docs-copy") !== "true") return;
  target.removeAttribute("data-copy-state");
  target.textContent = "Copy";
}

function documentationEscapeHtml(value: unknown): string {
  return String(value || "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#39;");
}

function documentationRenderBreadcrumbs(): string {
  return documentationView.breadcrumbs.map((item, index) => {
    const label = documentationEscapeHtml(item.label);
    const current = item.current || index === documentationView.breadcrumbs.length - 1;
    return current
      ? '<li aria-current="page" class="text-foreground">' + label + "</li>"
      : '<li><a href="' + documentationEscapeHtml(item.path) + '" data-zen-link="true" class="transition-colors hover:text-foreground focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">' + label + "</a></li>";
  }).join('<li aria-hidden="true" class="text-border">/</li>');
}

function documentationRenderSidebar(): string {
  return documentationView.sections.map((section) => {
    const links = section.entries.map((entry) => {
      const active = entry.current ? "border-primary text-foreground" : "border-border text-muted-foreground hover:border-foreground/40 hover:text-foreground";
      const current = entry.current ? ' aria-current="page"' : "";
      return '<a href="' + documentationEscapeHtml(entry.path) + '"' + current + ' data-zen-link="true" class="block border-l py-2 pl-4 text-sm transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring ' + active + '">' + documentationEscapeHtml(entry.sidebarLabel || entry.title) + "</a>";
    }).join("");
    return '<section><h2 class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted-foreground">' + documentationEscapeHtml(section.title) + '</h2><div class="mt-3 grid">' + links + "</div></section>";
  }).join("");
}
</script>

<div data-page-shell="docs-article" data-docs-shell="true" data-docs-sections-open={docsSectionsOpen ? "true" : "false"} data-docs-toc-open={docsTocOpen ? "true" : "false"} class="bg-background px-4 pb-0 pt-28 text-foreground sm:px-6 sm:pt-32 lg:px-8 lg:pt-36">
  <div data-docs-layout="true" class="mx-auto grid w-full max-w-7xl gap-10 lg:grid-cols-[15rem_minmax(0,1fr)] xl:grid-cols-[15rem_minmax(0,1fr)_13rem] xl:gap-14">
    <div data-docs-mobile-bar="true" class="docs-mobile-bar flex items-center justify-between gap-3 border-b border-border pb-3 lg:hidden">
      <button type="button" data-docs-sections-toggle="true" aria-expanded={docsSectionsOpen ? "true" : "false"} aria-controls="docs-sections" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border-strong bg-card px-4 text-[14px] font-medium text-foreground v1-focus" on:click={docsToggleSections}>{documentationView.sectionTitle} <span aria-hidden="true" class="text-muted-foreground">›</span> Sections</button>
    </div>

    <aside id="docs-sections" data-docs-sidebar="true" aria-label="Documentation sections" class="docs-sidebar lg:col-start-1 lg:row-start-1">
      <nav class="sticky top-28 grid max-h-[calc(100vh-8rem)] gap-8 overflow-y-auto pb-12">
        <DocumentationSidebarEntries html={documentationRenderSidebar()} class="grid gap-8" />
      </nav>
    </aside>

    <div data-docs-on-this-page="true" class="lg:col-start-2 lg:row-start-1 xl:col-start-3">
      <button type="button" data-docs-toc-toggle="true" aria-expanded={docsTocOpen ? "true" : "false"} aria-controls="docs-toc-panel" class="flex min-h-11 w-full items-center justify-between rounded-xl border border-border-strong bg-card px-4 text-[14px] font-medium text-foreground v1-focus xl:hidden" on:click={docsToggleToc}>On this page <span aria-hidden="true" class="text-muted-foreground">{docsTocOpen ? "▴" : "▾"}</span></button>
      <div id="docs-toc-panel" data-docs-toc-panel="true" class="docs-toc-panel sticky top-28">
        <ReaderToc
          headings={documentationView.headings}
          articleRef={documentationArticleRef}
          endRef={documentationArticleEndRef}
          labelId="docs-on-this-page"
          surface="docs"
        />
      </div>
    </div>

    <div id="app" class="w-full max-w-[44rem] min-w-0 lg:col-start-2 lg:row-start-2 xl:row-start-1">
      <main ref={documentationArticleRegionRef} data-docs-article-region="true" data-docs-transition-phase="idle" class="min-w-0">
        <header data-docs-article-header="true" class="pb-6">
          <nav aria-label="Breadcrumb">
            <ol class="flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-[0.16em] text-muted-foreground" unsafeHTML={documentationRenderBreadcrumbs()}></ol>
          </nav>
          <h1 data-route-title="true" class="mt-5 max-w-4xl font-heading text-[44px] font-semibold leading-[48px] tracking-[-0.03em] text-foreground md:text-[52px] md:leading-[56px]">{documentationView.title}</h1>
          <p class="mt-4 max-w-3xl text-[17px] leading-7 text-muted-foreground md:text-[18px]">{documentationView.description}</p>
        </header>

        <article ref={documentationArticleRef} data-docs-article="true" class="docs-richtext min-w-0 pb-10" on:click={docsArticleClick} on:animationend={docsArticleAnimationEnd} unsafeHTML={documentationView.htmlRendered}></article>
        <p ref={docsCopyLiveRef} data-docs-copy-live="true" aria-live="polite" class="sr-only"></p>
        <span ref={documentationArticleEndRef} data-reader-article-end="docs" class="block h-px" aria-hidden="true"></span>

        <a href={documentationNext ? documentationNext.path : "/docs"} data-zen-link="true" data-docs-next-step="true" class="block rounded-[14px] border border-border-strong bg-card p-5 transition-colors hover:bg-surface-2 v1-focus">
          <span class="v1-eyebrow">Next step</span>
          <span class="mt-2 block font-heading text-[20px] font-semibold leading-7 text-primary">{documentationNext ? documentationNext.title : "Documentation"} →</span>
          <span class="mt-2 block text-[14px] leading-6 text-muted-foreground">{documentationNext ? documentationNext.excerpt || "" : "Back to the documentation index."}</span>
        </a>
        <nav aria-label="Documentation pagination" class="mt-6 flex flex-wrap gap-3">
          <a href={documentationPrevious ? documentationPrevious.path : "/docs"} data-zen-link="true" aria-label={documentationPrevious ? "Previous: " + documentationPrevious.title : "Previous: Documentation"} class="v1-button v1-button-outline">← Previous</a>
          <a href={documentationNext ? documentationNext.path : "/docs"} data-zen-link="true" aria-label={documentationNext ? "Next: " + documentationNext.title : "Next: Documentation"} class="v1-button v1-button-outline">Next →</a>
        </nav>
        <div class="mt-8 border-t border-border py-6" hidden={docsEditUrl ? undefined : true}>
          <a href={docsEditUrl} target="_blank" rel="noopener noreferrer" data-docs-edit="true" class="v1-link inline-flex min-h-11 items-center gap-2 text-[14px] font-medium">Edit this page on GitHub<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </main>
      <DocsArticleTransition articleRegionRef={documentationArticleRegionRef} currentPath={documentationView.path} />
    </div>
  </div>
</div>
