<script lang="ts">
import ThemeToggle from "./ThemeToggle.zen";
import ZenithNavigationMark from "@/components/ZenithNavigationMark.zen";
import Icon from "@/components/site-v1/Icon.zen";
import SearchTrigger from "@/components/search/SearchTrigger.zen";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  content?: {
    mainLinks?: NavLink[];
  };
  currentPath?: string;
  shellRef?: any;
  logoTargetRef?: any;
  linksRef?: any;
  actionsRef?: any;
  introGated?: boolean;
}

interface NavigationWindow extends Window {
  __zenithNavigationLogoTarget?: HTMLElement;
}

const navigationProps = props as Props;
const navigationCurrentPath = navigationProps.currentPath || "/";
const navigationIntroGated = navigationProps.introGated === true;
const localNavigationShellRef = ref<HTMLElement>();
const localNavigationLogoTargetRef = ref<HTMLElement>();
const localNavigationLinksRef = ref<HTMLElement>();
const localNavigationActionsRef = ref<HTMLElement>();
const mobileNavigationTriggerRef = ref<HTMLButtonElement>();
const navigationShellRef = localNavigationShellRef;
const navigationLogoTargetRef = localNavigationLogoTargetRef;
const navigationLinksRef = localNavigationLinksRef;
const navigationActionsRef = localNavigationActionsRef;
const forwardedNavigationShellRef = navigationProps.shellRef;
const forwardedNavigationLogoTargetRef = navigationProps.logoTargetRef;
const forwardedNavigationLinksRef = navigationProps.linksRef;
const forwardedNavigationActionsRef = navigationProps.actionsRef;

// Labels are literal and layout-critical styles are mirrored by static slot classes
// (site-v1-components.css): Zenith applies attribute/text expressions on hydrate, not in SSR HTML.
// v1 nav (handoff §4 Nav): 15/20 medium muted links, current page in foreground with a primary
// underline. Hover is not drawn in Figma: minimal token hover (foreground text), flagged for UI.
const navLinkBase = "inline-flex min-h-11 items-center border-b-2 text-[15px] font-medium leading-5 transition-colors v1-focus";
const mobileLinkBase = "flex min-h-12 items-center border-b border-border py-3 font-heading text-[22px] font-semibold text-foreground v1-focus";

function normalizePath(pathname: string) {
  if (pathname === "/") return "/";
  return pathname.replace(/\/+$/, "") || "/";
}

function isActivePath(href: string) {
  if (href.includes("#")) return false;
  const current = normalizePath(navigationCurrentPath);
  const target = normalizePath(href);
  return target === "/" ? current === "/" : current === target || current.startsWith(`${target}/`);
}

function navLinkClass(href: string) {
  return isActivePath(href)
    ? `${navLinkBase} border-primary text-foreground`
    : `${navLinkBase} border-transparent text-muted-foreground hover:text-foreground`;
}

state mobileOpen = false;

function toggleMobileMenu() {
  mobileOpen = !mobileOpen;
}

function closeMobileMenu() {
  mobileOpen = false;
}

function handleNavigationKeydown(event: KeyboardEvent) {
  if (event.key !== "Escape" || !mobileOpen) return;
  event.preventDefault();
  mobileOpen = false;
  mobileNavigationTriggerRef.current?.focus();
}

zenMount((ctx) => {
  const win = zenWindow() as NavigationWindow | null;
  const logoTarget = navigationLogoTargetRef.current || null;
  if (!win || !logoTarget) return;
  if (forwardedNavigationShellRef) forwardedNavigationShellRef.current = navigationShellRef.current || null;
  if (forwardedNavigationLogoTargetRef) forwardedNavigationLogoTargetRef.current = logoTarget;
  if (forwardedNavigationLinksRef) forwardedNavigationLinksRef.current = navigationLinksRef.current || null;
  if (forwardedNavigationActionsRef) forwardedNavigationActionsRef.current = navigationActionsRef.current || null;
  logoTarget.setAttribute("data-navigation-logo-runtime", "true");
  win.__zenithNavigationLogoTarget = logoTarget;

  ctx.cleanup(() => {
    logoTarget.removeAttribute("data-navigation-logo-runtime");
    if (forwardedNavigationShellRef) forwardedNavigationShellRef.current = null;
    if (forwardedNavigationLogoTargetRef) forwardedNavigationLogoTargetRef.current = null;
    if (forwardedNavigationLinksRef) forwardedNavigationLinksRef.current = null;
    if (forwardedNavigationActionsRef) forwardedNavigationActionsRef.current = null;
    if (win.__zenithNavigationLogoTarget === logoTarget) delete win.__zenithNavigationLogoTarget;
  });
});

</script>

<header
  ref={localNavigationShellRef}
  data-intro-gated={navigationIntroGated ? "true" : undefined}
  data-nav-shell="true"
  class="fixed inset-x-0 top-0 z-50 border-b border-border bg-background text-foreground"
  on:keydown={handleNavigationKeydown}
>
  <nav class="mx-auto flex h-16 w-full max-w-[1440px] items-center justify-between gap-4 px-4 md:h-[72px] md:px-8" aria-label="Primary">
    <div class="flex items-center gap-6 lg:gap-10">
      <span
        class="nav-logo-slot inline-flex h-10 shrink-0 items-center"
      >
        <a
          href="/" data-zen-link="true"
          aria-label="Zenith home"
          class="group flex min-h-11 items-center gap-2 rounded-full v1-focus"
        >
          <span ref={localNavigationLogoTargetRef} data-nav-logo-target="true" class="grid h-10 w-10 shrink-0 place-items-center rounded-full"><ZenithNavigationMark /></span>
          <span class="font-heading text-[20px] font-semibold leading-6 text-foreground md:hidden lg:inline lg:text-[22px]">Zenith</span>
        </a>
      </span>

      <div ref={localNavigationLinksRef} class="nav-links-slot hidden items-center gap-5 md:flex lg:gap-7">
        <a href="/docs" data-zen-link="true" aria-current={isActivePath("/docs") ? "page" : undefined} class={navLinkClass("/docs")}>Docs</a>
        <a href="/#how-it-works" class={navLinkClass("/#how-it-works")}>How it works</a>
        <a href="/performance" data-zen-link="true" aria-current={isActivePath("/performance") ? "page" : undefined} class={navLinkClass("/performance")}>Performance</a>
        <a href="/blog" data-zen-link="true" aria-current={isActivePath("/blog") ? "page" : undefined} class={navLinkClass("/blog")}>Blog</a>
      </div>
    </div>

    <div ref={localNavigationActionsRef} class="flex items-center justify-end gap-2 lg:gap-[10px]" data-nav-actions="true">
      <SearchTrigger scope="global" label="Search" class="relative h-11! w-12 justify-center px-0! border-border-strong! text-muted-foreground lg:w-auto lg:justify-start lg:px-4!" />
      <span data-nav-theme-toggle="true" class="inline-flex">
        <ThemeToggle />
      </span>
      <span class="nav-cta-slot hidden items-center gap-2 md:inline-flex lg:gap-[10px]">
      <a
        href="https://github.com/zenithbuild/framework"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub (opens in a new tab)"
        class="hidden min-h-11 items-center gap-2 rounded-full px-3 text-[14px] font-medium leading-[18px] text-primary hover:bg-muted v1-focus md:inline-flex lg:px-[14px]"
      >
        <span class="hidden lg:inline">GitHub</span>
        <Icon name="github" />
      </a>
      <a href="/docs/getting-started" data-zen-link="true" class="hidden min-h-11 items-center rounded-full bg-primary px-[14px] text-[14px] font-medium leading-[18px] text-primary-foreground transition-colors hover:bg-primary-hover-bg hover:text-primary-hover-fg v1-focus md:inline-flex">Get started</a>
      </span>
      <button
        ref={mobileNavigationTriggerRef}
        type="button"
        data-mobile-nav-trigger="true"
        aria-label={mobileOpen ? "Close navigation menu" : "Open navigation menu"}
        aria-expanded={mobileOpen ? "true" : "false"}
        aria-controls="mobile-navigation"
        class="relative inline-flex h-11 w-11 items-center justify-center rounded-full border border-border-strong bg-card text-foreground v1-focus md:hidden"
        on:click={toggleMobileMenu}
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d={mobileOpen ? "M6 6l12 12M18 6L6 18" : "M4 7h16M4 12h16M4 17h16"} />
        </svg>
      </button>
    </div>
  </nav>

  <div class="nav-mobile-slot md:hidden">
  <div
    id="mobile-navigation"
    aria-hidden={mobileOpen ? "false" : "true"}
    inert={mobileOpen ? undefined : true}
    class={mobileOpen ? "border-t border-border bg-background px-4 pb-6 pt-2 md:hidden" : "hidden"}
  >
    <nav class="mx-auto grid w-full" aria-label="Mobile primary">
      <a href="/docs" data-zen-link="true" aria-current={isActivePath("/docs") ? "page" : undefined} class={mobileLinkBase} on:click={closeMobileMenu}>Docs</a>
      <a href="/#how-it-works" class={mobileLinkBase} on:click={closeMobileMenu}>How it works</a>
      <a href="/performance" data-zen-link="true" aria-current={isActivePath("/performance") ? "page" : undefined} class={mobileLinkBase} on:click={closeMobileMenu}>Performance</a>
      <a href="/blog" data-zen-link="true" aria-current={isActivePath("/blog") ? "page" : undefined} class={mobileLinkBase} on:click={closeMobileMenu}>Blog</a>
      <a href="https://github.com/zenithbuild/framework" target="_blank" rel="noopener noreferrer" class={mobileLinkBase} on:click={closeMobileMenu}>GitHub</a>
      <a href="/docs/getting-started" data-zen-link="true" class="mt-4 inline-flex min-h-11 items-center justify-center rounded-full bg-primary px-5 text-[15px] font-medium text-primary-foreground v1-focus" on:click={closeMobileMenu}>Get started</a>
    </nav>
  </div>
  </div>
</header>
