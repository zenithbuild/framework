<script server lang="ts">
import { pageContent, siteContent } from "../content/index";
import { createPageMetadata } from "../content/site/metadata";

export const load = async (ctx) => {
    return ctx.data({
        page: pageContent.index,
        metadata: createPageMetadata("/"),
        site: {
            navigation: siteContent.navigation,
            footer: siteContent.footer,
        }
    });
};
</script>

<script setup="ts">
import DefaultLayout from "@/layouts/DefaultLayout.zen";
import HomeHero from "@/components/site-v1/HomeHero.zen";
import PipelineSection from "@/components/site-v1/PipelineSection.zen";
import WhyZenithSection from "@/components/site-v1/WhyZenithSection.zen";
import ClosingCta from "@/components/site-v1/ClosingCta.zen";

// One polite live region shared by every Copy control on the page (handoff §5).
const homeCopyLiveRef = ref<HTMLElement>();
</script>

<DefaultLayout title={data.page.title} description={data.page.description} metadata={data.metadata} navigationContent={data.site.navigation} footerContent={data.site.footer} currentPath="/" introEnabled={true}>
    <div data-home-content-shell="true" data-v1-home="true" class="relative bg-background pt-16 text-foreground md:pt-[73px]">
        <HomeHero copyLiveRef={homeCopyLiveRef} />
        <PipelineSection />
        <WhyZenithSection />
        <ClosingCta copyLiveRef={homeCopyLiveRef} />
        <p ref={homeCopyLiveRef} data-copy-live="true" aria-live="polite" class="sr-only"></p>
    </div>
</DefaultLayout>
