            <div class="absolute left-1/2 top-1/4 h-64 w-64 -translate-x-1/2 rounded-full bg-accent-blue/20 blur-3xl" />
            <div class="absolute bottom-1/4 right-1/4 h-56 w-56 rounded-full bg-accent-violet/20 blur-3xl" />
        </div>

        <div class="relative z-10 max-w-3xl space-y-8">
            <span class={kicker}>0.8.0 foundation release</span>

            <h1 class="font-display text-5xl font-bold tracking-tight text-foreground sm:text-7xl">
                Build faster.
                <span class="block text-accent-blue">Ship safer.</span>
