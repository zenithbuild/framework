{
  "name": "@zenithbuild/framework",
  "private": true,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zenithbuild/framework"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge": "4.1.2",
    "glob": "14.0.3",
    "minimatch": "11.0.4",
    "ws": "8.21.0"
  },
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "ci": "bash ./scripts/ci.sh",
    "smoke": "bash ./scripts/smoke.sh",
    "test": "bun run ci"
  }
}
